MERGE (n:Setting { id: '899029e8-6d29-43d9-8716-77d4e6ceac29' }) SET n.visualPrompt = 'A grand and solemn courtroom with high ceilings, dark wooden paneling on the walls, and a stone or dark wood floor. Elevated platforms for the judge and clerks dominate the front, flanked by a jury box and a witness stand. Rows of benches fill the public gallery. The room is illuminated by a few artificial lamps, likely oil or gas lamps, casting warm, flickering light and deep, dramatic shadows across the architectural details.', n.locationName = 'Trial Courtroom', n.storySignificance = 'The primary location for Jean Valjean\'s dramatic self-revelation, marking a turning point in the narrative.', n.staticObjectsJson = '["Elevated judge\'s bench","Jury box","Witness stand","Public gallery seating","Dark wood paneling","Artificial lamps"]', n.locationType = 'INDOOR', n.description = 'A formal hall designed for judicial proceedings, filled with an expectant and tense atmosphere, where a pivotal moment of truth is about to unfold.', n.isPrimaryLocation = true, n.lightingDescription = 'Artificial light from oil/gas lamps, casting warm glows and deep shadows.', n.name = 'Trial Courtroom', n.atmosphereKeywords = 'solemn, tense, dramatic, awestruck', n.weatherCondition = 'clear', n.artStyle = 'Dark Fantasy, Realistic, Cinematic Lighting', n.projectId = 'dff690f8-fd47-4553-8844-eb25eec8b908', n.visualBackground = 'A grand and solemn courtroom with high ceilings, dark wooden paneling on the walls, and a stone or dark wood floor. Elevated platforms for the judge and clerks dominate the front, flanked by a jury box and a witness stand. Rows of benches fill the public gallery. The room is illuminated by a few artificial lamps, likely oil or gas lamps, casting warm, flickering light and deep, dramatic shadows across the architectural details.', n.timeOfDay = 'unknown'
CREATE (::Setting { name: 'Courtroom Hall', description: 'The interior of a grand courtroom, set for a trial, where a momentous confession unfolds. The space is designed for legal proceedings, with distinct areas for the judge, jury, prosecutor, witnesses, and the public.', locationType: 'indoor', projectId: 'dff690f8-fd47-4553-8844-eb25eec8b908' })
MERGE (n:Setting { id: 'b1da97a1-8d3b-443b-9d22-7012ba57393b' }) SET n.visualPrompt = 'A large, solemn courtroom hall featuring high ceilings and dark, polished wood paneling. A prominent, elevated judge\'s bench dominates one end, flanked by a prosecutor\'s area. Across, a structured jury box contains multiple seating arrangements. A central witness stand is positioned for clear visibility to both court and public. Rows of sturdy wooden benches fill the public gallery behind a railing. The overall atmosphere is formal and austere.', n.locationName = 'Courtroom Hall', n.storySignificance = 'This courtroom is the setting for Jean Valjean\'s monumental public confession, a pivotal moment of self-sacrifice and revelation that defines the climax of a major narrative arc.', n.staticObjectsJson = '["Judge\'s bench","Jury box","Witness stand","Public gallery","Secretary\'s lamp","Dark wood paneling","High ceilings"]', n.description = 'The interior of a grand courtroom, set for a trial, where a momentous confession unfolds. The space is designed for legal proceedings, with distinct areas for the judge, jury, prosecutor, witnesses, and the public.', n.locationType = 'INDOOR', n.isPrimaryLocation = true, n.lightingDescription = 'Subdued ambient lighting throughout the hall, possibly from high windows or unseen fixtures. A distinct, focused yellowish light emanates from a secretary\'s lamp on a desk, creating a spotlight effect on a central area. Additional portable light sources are available for specific examination.', n.name = 'Courtroom Hall', n.atmosphereKeywords = 'Tense, solemn, dramatic, awe-inspiring, formal', n.projectId = 'dff690f8-fd47-4553-8844-eb25eec8b908', n.visualBackground = 'A large, solemn courtroom hall featuring high ceilings and dark, polished wood paneling. A prominent, elevated judge\'s bench dominates one end, flanked by a prosecutor\'s area. Across, a structured jury box contains multiple seating arrangements. A central witness stand is positioned for clear visibility to both court and public. Rows of sturdy wooden benches fill the public gallery behind a railing. The overall atmosphere is formal and austere.', n.timeOfDay = 'unknown'
MERGE (n:Setting { id: 'a53918dc-5182-4653-a6ec-047fb7710d56' }) SET n.visualPrompt = 'A grand, formal courtroom constructed of dark, polished wood and heavy stone, featuring a raised judge\'s dais with a large, ornate bench, a distinct jury box to one side, and tiered public seating made of wooden benches. A clerk\'s desk is positioned strategically, illuminated by a focused, brass lamp that casts a distinct pool of light onto its surface, creating deep shadows in the surrounding areas of the vast hall.', n.locationName = 'Courtroom', n.storySignificance = 'This is the primary location for a pivotal scene where a major character makes a significant confession, altering the course of justice and the narrative.', n.staticObjectsJson = '["Judge\'s dais and bench","Jury box","Public seating area","Clerk\'s desk with lamp","Wooden and stone architectural elements"]', n.description = 'The interior of a courthouse where a dramatic trial unfolds. The room is designed for legal proceedings, with specific areas for judges, jury, witnesses, and the public.', n.locationType = 'INDOOR', n.isPrimaryLocation = true, n.lightingDescription = 'Localized, focused light from a clerk\'s lamp, creating strong contrasts with the general ambient illumination of the large court hall, which is otherwise dim or underlit.', n.name = 'Courtroom', n.atmosphereKeywords = 'Tense, solemn, dramatic, silent, awe-struck', n.projectId = 'dff690f8-fd47-4553-8844-eb25eec8b908', n.visualBackground = 'A grand, formal courtroom constructed of dark, polished wood and heavy stone, featuring a raised judge\'s dais with a large, ornate bench, a distinct jury box to one side, and tiered public seating made of wooden benches. A clerk\'s desk is positioned strategically, illuminated by a focused, brass lamp that casts a distinct pool of light onto its surface, creating deep shadows in the surrounding areas of the vast hall.', n.timeOfDay = 'unknown'

