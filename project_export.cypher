CREATE (::Setting { name: 'Courtroom', description: 'The interior of a courthouse where a dramatic trial unfolds. The room is designed for legal proceedings, with specific areas for judges, jury, witnesses, and the public.', locationType: 'indoor', projectId: 'dff690f8-fd47-4553-8844-eb25eec8b908' })
MERGE (n:Setting { id: 'c78521a5-bba0-4cfb-b4f5-fb124f7bd63e' }) SET n.visualPrompt = 'A formal 19th-century French courtroom with an elevated, ornate wooden judge\'s bench at the front. A central witness stand is positioned for prominence. To the side, a partitioned jury box with multiple seats is visible. Rows of dark wooden benches, likely tiered, fill the public gallery. The walls are paneled with dark wood or aged plaster, extending to a high, possibly vaulted ceiling. The overall architecture is grand and solemn, designed to convey authority and gravity.', n.locationName = 'Courtroom', n.storySignificance = 'This courtroom is the central stage for a pivotal moment in the story: the dramatic confession of the protagonist, revealing his true identity and challenging the justice system. It serves as a place of judgment and moral confrontation.', n.staticObjectsJson = '["Elevated judge\'s bench","Witness stand","Jury box","Public gallery benches","Dark wooden paneling","Artificial lamps"]', n.locationType = 'indoor', n.description = 'The interior of a courthouse where a dramatic trial unfolds. The room is designed for legal proceedings, with specific areas for judges, jury, witnesses, and the public.', n.isPrimaryLocation = true, n.lightingDescription = 'Artificial light from focused lamps illuminates key areas, particularly the judge\'s bench and witness stand. The rest of the large hall is cast in dimmer, indirect light, creating deep shadows and a somber ambiance.', n.name = 'Courtroom', n.atmosphereKeywords = 'Solemn, tense, formal, expectant, dramatic.', n.weatherCondition = 'N/A', n.artStyle = 'Dark Fantasy, Realistic, Cinematic Lighting', n.projectId = 'dff690f8-fd47-4553-8844-eb25eec8b908', n.visualBackground = 'A formal 19th-century French courtroom with an elevated, ornate wooden judge\'s bench at the front. A central witness stand is positioned for prominence. To the side, a partitioned jury box with multiple seats is visible. Rows of dark wooden benches, likely tiered, fill the public gallery. The walls are paneled with dark wood or aged plaster, extending to a high, possibly vaulted ceiling. The overall architecture is grand and solemn, designed to convey authority and gravity.', n.timeOfDay = 'night'
MERGE (n:Setting { id: '94a5a267-72e7-42cc-b238-2c8be2d0cc89' }) SET n.visualPrompt = 'A grand, formal courtroom featuring high ceilings and tall, arched windows. The walls are adorned with dark, polished wood paneling and intricate carved details. At the front, a raised wooden dais supports a large, imposing bench for the judge. Below it, a designated witness stand and sturdy wooden tables are arranged for the prosecution and defense. Numerous rows of plain wooden benches provide seating for the jury and a gallery for the public. A single, focused clerk\'s lamp casts a bright, concentrated circle of light onto a desk, creating sharp contrast with the ambient daylight filtering softly through the high windows, resulting in areas of deep shadow and dramatic illumination throughout the spacious hall.', n.locationName = 'Courtroom', n.storySignificance = 'The primary setting for a major plot revelation, where the protagonist confesses his true identity, leading to a profound shift in the narrative.', n.staticObjectsJson = '["High ceilings","Tall windows","Dark wood paneling","Judge\'s dais and bench","Witness stand","Jury box","Public gallery seating","Clerk\'s lamp"]', n.description = 'The interior of a courthouse where a dramatic trial unfolds. The room is designed for legal proceedings, with specific areas for judges, jury, witnesses, and the public.', n.locationType = 'indoor', n.isPrimaryLocation = true, n.lightingDescription = 'Natural daylight from high windows, supplemented by a focused artificial lamp; strong contrasts of light and shadow.', n.name = 'Courtroom', n.atmosphereKeywords = 'Formal, tense, somber, dramatic, awe-inspiring', n.projectId = 'dff690f8-fd47-4553-8844-eb25eec8b908', n.visualBackground = 'A grand, formal courtroom featuring high ceilings and tall, arched windows. The walls are adorned with dark, polished wood paneling and intricate carved details. At the front, a raised wooden dais supports a large, imposing bench for the judge. Below it, a designated witness stand and sturdy wooden tables are arranged for the prosecution and defense. Numerous rows of plain wooden benches provide seating for the jury and a gallery for the public. A single, focused clerk\'s lamp casts a bright, concentrated circle of light onto a desk, creating sharp contrast with the ambient daylight filtering softly through the high windows, resulting in areas of deep shadow and dramatic illumination throughout the spacious hall.', n.timeOfDay = 'afternoon'
MERGE (n:Setting { id: 'a8dea526-7aac-4f5d-8abe-b2f51490699d' }) SET n.visualPrompt = 'A formal 19th-century courtroom, characterized by high ceilings and dark, polished wooden paneling on the walls. Intricate architectural details adorn the upper portions. A raised dais at the front features a large, imposing judge\'s bench, flanked by a prosecutor\'s desk. An elevated witness stand is positioned to one side. Rows of plain wooden benches for the jury are arranged opposite, with a public gallery filling the space behind them. Secretary\'s lamps on various desks cast focused, yellow pools of light onto specific areas, leaving much of the large room in deep, dramatic shadows.', n.locationName = 'Courtroom', n.storySignificance = 'This courtroom is the pivotal location where the protagonist, M. Madeleine (Jean Valjean), dramatically reveals his true identity, saving an innocent man and profoundly impacting all present.', n.staticObjectsJson = '["Judge\'s bench","Prosecutor\'s table","Witness stand","Jury box","Public gallery","Dark wood paneling","Secretary\'s lamps"]', n.description = 'The interior of a courthouse where a dramatic trial unfolds. The room is designed for legal proceedings, with specific areas for judges, jury, witnesses, and the public.', n.locationType = 'indoor', n.isPrimaryLocation = true, n.lightingDescription = 'Focused, stark yellow light from secretary\'s lamps, creating strong contrasts; large areas of deep shadow throughout the formal room, with supplemental light brought closer by gendarmes.', n.name = 'Courtroom', n.atmosphereKeywords = 'Tense, solemn, dramatic, silent, awestruck, somber.', n.projectId = 'dff690f8-fd47-4553-8844-eb25eec8b908', n.visualBackground = 'A formal 19th-century courtroom, characterized by high ceilings and dark, polished wooden paneling on the walls. Intricate architectural details adorn the upper portions. A raised dais at the front features a large, imposing judge\'s bench, flanked by a prosecutor\'s desk. An elevated witness stand is positioned to one side. Rows of plain wooden benches for the jury are arranged opposite, with a public gallery filling the space behind them. Secretary\'s lamps on various desks cast focused, yellow pools of light onto specific areas, leaving much of the large room in deep, dramatic shadows.', n.timeOfDay = 'unknown'
MERGE (n:Setting { id: 'f01d9c66-be91-4c99-a984-0164029f39d2' }) SET n.visualPrompt = 'A formal 19th-century courtroom with high ceilings and walls adorned with dark wood paneling. A raised judge\'s bench dominates one end, flanked by a prosecutor\'s desk and a defense counsel\'s table. In front, a witness stand is illuminated by a clerk\'s lamp, casting a localized glow. Opposite the bench, a jury box with multiple seats. Behind these, tiered seating for a public audience. The overall lighting is dim, emphasizing the dramatic focal points, with deep shadows in the corners.', n.locationName = 'Courtroom', n.storySignificance = 'This is the pivotal location where Jean Valjean makes his confession, drastically altering the course of justice and his personal fate.', n.staticObjectsJson = '["Judge\'s bench","Prosecutor\'s desk","Jury box","Witness stand","Audience seating","Clerk\'s lamp"]', n.locationType = 'indoor', n.description = 'The interior of a courthouse where a dramatic trial unfolds. The room is designed for legal proceedings, with specific areas for judges, jury, witnesses, and the public.', n.isPrimaryLocation = true, n.lightingDescription = 'Localized artificial light from a clerk\'s lamp on the witness stand, ambient dim light throughout the hall.', n.name = 'Courtroom', n.atmosphereKeywords = 'Solemn, tense, dramatic, austere, formal', n.firstMentioned = 'Text start', n.artStyle = '19th Century Realism, classical', n.projectId = 'dff690f8-fd47-4553-8844-eb25eec8b908', n.visualBackground = 'A formal 19th-century courtroom with high ceilings and walls adorned with dark wood paneling. A raised judge\'s bench dominates one end, flanked by a prosecutor\'s desk and a defense counsel\'s table. In front, a witness stand is illuminated by a clerk\'s lamp, casting a localized glow. Opposite the bench, a jury box with multiple seats. Behind these, tiered seating for a public audience. The overall lighting is dim, emphasizing the dramatic focal points, with deep shadows in the corners.', n.timeOfDay = 'unknown'
