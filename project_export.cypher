MERGE (n:Setting { id: 'c69001a2-c8c5-4242-9b60-33dc4f5d3267' }) SET n.visualPrompt = 'A grand and formal 19th-century French courtroom with high ceilings, perhaps featuring tall, dark arched windows that are currently obscured, suggesting night. The interior is adorned with robust, dark polished mahogany or oak wooden paneling and heavy, traditional furnishings. A prominent, raised judicial bench, sturdy desks for the prosecutor and defense counsel, and a witness stand are centrally arranged. Rows of solemn, aged wooden benches fill the public gallery. A brass and glass secretary\'s lamp provides a strong, localized artificial light, creating sharp contrasts and deep shadows within the otherwise dimly lit, vast space.', n.storySignificance = 'The primary location for a pivotal, dramatic confession that reveals a key character\'s true identity and profoundly alters the narrative\'s trajectory concerning justice.', n.locationName = 'Arras Courtroom', n.staticObjectsJson = '["Raised judicial bench","Prosecutor\'s desk","Defense counsel table","Witness stand","Public gallery seating","Secretary\'s lamp (brass and glass)","Dark wooden paneling (mahogany or oak)","High ceilings","Formal wooden benches"]', n.description = 'The formal and imposing setting of a 19th-century courtroom in Arras, serving as the dramatic stage for a pivotal trial culminating in a profound public confession.', n.locationType = 'INDOOR', n.lightingDescription = 'Localized, strong artificial light from a secretary\'s lamp intensely illuminates the central area, creating stark contrasts of brightness and deep shadows. The broader courtroom remains in a dim, somber state, lit indirectly by the central glow.', n.isPrimaryLocation = true, n.name = 'Arras Courtroom', n.atmosphereKeywords = 'solemn, tense, dramatic, formal, awe-inspiring, profound silence', n.visualBackground = 'A grand and formal 19th-century French courtroom with high ceilings, perhaps featuring tall, dark arched windows that are currently obscured, suggesting night. The interior is adorned with robust, dark polished mahogany or oak wooden paneling and heavy, traditional furnishings. A prominent, raised judicial bench, sturdy desks for the prosecutor and defense counsel, and a witness stand are centrally arranged. Rows of solemn, aged wooden benches fill the public gallery. A brass and glass secretary\'s lamp provides a strong, localized artificial light, creating sharp contrasts and deep shadows within the otherwise dimly lit, vast space.', n.projectId = 'dff690f8-fd47-4553-8844-eb25eec8b908', n.timeOfDay = 'night', n.settingId = 'loc_arras_courtroom_01'
